    "./widgets/webwriter-pages": {
      "resize": "inline",
      "propagateEvents": [
        "keydown"
      ],
      "definingAsContext": true,
      "definingForContent": true,
      "content": "webwriter-page+"
    },
    "./widgets/webwriter-page": {
      "resize": "none",
      "definingAsContext": true,
      "definingForContent": true,
      "content": "p | flow*",
      "uninsertable": true
    }
  },
  "customElements": "custom-elements.json",
  "prebuiltDependencies": [
